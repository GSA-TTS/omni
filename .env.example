# omni-sync environment configuration
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored -- never commit real tokens.

# ─────────────────────────────────────────────────────────────────────
# Jira (GSA FedRAMP GovCloud) — API token auth
# Create a token at:
#   https://id.atlassian-us-gov-mod.com/manage-profile/security/api-tokens
#   -> Create API token
# ─────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://gsa-standard.atlassian-us-gov-mod.net
JIRA_EMAIL=your.name@gsa.gov
JIRA_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Target repos / projects (resolved by the omni-sync CLI)
# ─────────────────────────────────────────────────────────────────────
GH_TTS_REPO=gsa-tts/core-repo
GH_HELIX_REPO=org/repo
GL_CG_REPO=group/project
JIRA_MOD_PROJECT=FPDF

# ─────────────────────────────────────────────────────────────────────
# Provider host overrides (defaults also set by mise.toml)
# ─────────────────────────────────────────────────────────────────────
GITHUB_PUBLIC_HOST=github.com
HELIX_GH_HOST=github.helix.gsa.gov
CLOUDGOV_GLAB_HOST=workshop.cloud.gov
JIRA_INSTANCE_URL=https://gsa-standard.atlassian-us-gov-mod.net

# ─────────────────────────────────────────────────────────────────────
# GitLab personal access token (optional; `glab auth login` is preferred).
# Needs `api` + `write_repository` scopes. If set, it takes precedence
# over any token stored by `glab auth login`.
# ─────────────────────────────────────────────────────────────────────
# GITLAB_TOKEN=
